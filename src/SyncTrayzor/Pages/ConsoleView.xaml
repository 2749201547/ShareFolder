<UserControl x:Class="SyncTrayzor.Pages.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:l="clr-namespace:SyncTrayzor.Localization"
             mc:Ignorable="d" 
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:xaml="clr-namespace:SyncTrayzor.Xaml"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <xaml:LogMessageListToStringConverter x:Key="LogMessagesConverter"/>

        <!-- Quiet dark scrollbar to match console chrome -->
        <SolidColorBrush x:Key="ConsoleScrollTrack" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ConsoleScrollThumb" Color="#424242"/>
        <SolidColorBrush x:Key="ConsoleScrollThumbHover" Color="#4F4F4F"/>

        <Style x:Key="ConsoleScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{StaticResource ConsoleScrollThumb}"
                                CornerRadius="3" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ConsoleScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ConsoleScrollThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource ConsoleScrollTrack}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{StaticResource ConsoleScrollTrack}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ConsoleScrollBarPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ConsoleScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ConsoleScrollBarPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{StaticResource ConsoleScrollTrack}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ConsoleScrollBarPageButton}"
                                                          Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ConsoleScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ConsoleScrollBarPageButton}"
                                                          Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Background="#1E1E1E">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Height="28"
                   Background="#252526">
            <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontWeight="Bold" Foreground="#CCCCCC"
                       Text="{l:Loc ConsoleView_Title}"/>
            <Button DockPanel.Dock="Right" Padding="8,0" Margin="0,3,5,3" Height="NaN" MinWidth="50"
                    Foreground="#CCCCCC" Background="#2B2B2B" BorderBrush="#3C3C3C"
                    Command="{s:Action ShowSettings}" Content="{l:Loc ConsoleView_SettingsButton}"/>
            <Button DockPanel.Dock="Right" Padding="8,0" Margin="0,3,5,3" Height="NaN" MinWidth="50"
                    Foreground="#CCCCCC" Background="#2B2B2B" BorderBrush="#3C3C3C"
                    Command="{s:Action ClearLog}" Content="{l:Loc ConsoleView_ClearButton}"/>
            <Button DockPanel.Dock="Right" Padding="8,0" Margin="0,3,5,3" Height="NaN" MinWidth="50"
                    Foreground="#CCCCCC" Background="#2B2B2B" BorderBrush="#3C3C3C"
                    Command="{s:Action PauseLog}" Content="{l:Loc ConsoleView_PauseButton}"
                    Visibility="{Binding LogPaused, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}"/>
            <Button DockPanel.Dock="Right" Padding="8,0" Margin="0,3,5,3" Height="NaN" MinWidth="50"
                    Foreground="#CCCCCC" Background="#2B2B2B" BorderBrush="#3C3C3C"
                    Command="{s:Action ResumeLog}" Content="{l:Loc ConsoleView_ResumeButton}"
                    Visibility="{Binding LogPaused, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"/>
        </DockPanel>
        <TextBox ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="11"
                 IsReadOnly="True"
                 UndoLimit="0"
                 Background="#1E1E1E"
                 Foreground="#D4D4D4"
                 BorderThickness="0"
                 CaretBrush="#D4D4D4"
                 Text="{Binding LogMessages, Converter={StaticResource LogMessagesConverter}, Mode=OneWay}"
                 FlowDirection="LeftToRight">
            <i:Interaction.Behaviors>
                <xaml:ScrollToEndBehaviour/>
            </i:Interaction.Behaviors>
        </TextBox>
    </DockPanel>
</UserControl>
